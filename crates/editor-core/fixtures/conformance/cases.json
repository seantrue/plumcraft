        {"call": "command.run", "params": {"command": "node.add", "params": {"kind": "text.upper", "pos": [500, 0]}}, "save": {"b": "/result/id"}},
        {"call": "command.run", "params": {"command": "wire.connect", "params": {"from": {"node": "$a", "port": "text"}, "to": {"node": "$b", "port": "text"}}}},
        {"call": "command.run", "params": {"command": "group.create", "params": {"nodes": ["$b"], "collapsed": true}}},
