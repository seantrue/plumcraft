        {"call": "theme.get", "save": {"theme": "/result"}, "expect": {"/result/tokens/pin_hidden": {"$len": 4}, "/result/tokens/group": {"$len": 4}}},
        {"check": "tokensResolved", "scene": "$scene", "theme": "$theme"}
      ]
    },
    {
      "name": "no two items of a scene share a nid",
      "about": "faces, wires, nets, frames and groups are numbered from one counter a document",
      "steps": [
        {"call": "command.run", "params": {"command": "node.add", "params": {"kind": "text.literal", "pos": [0, 0]}}, "save": {"a": "/result/id"}},
        {"call": "command.run", "params": {"command": "node.add", "params": {"kind": "text.upper", "pos": [500, 0]}}, "save": {"b": "/result/id"}},
        {"call": "command.run", "params": {"command": "node.add", "params": {"kind": "text.lower", "pos": [500, 400]}}, "save": {"c": "/result/id"}},
        {"call": "command.run", "params": {"command": "wire.connect", "params": {"from": {"node": "$a", "port": "text"}, "to": {"node": "$b", "port": "text"}}}},
        {"call": "command.run", "params": {"command": "frame.add", "params": {"pos": [-600, 600], "size": [300, 200]}}},
        {"call": "command.run", "params": {"command": "group.create", "params": {"nodes": ["$c"]}}},
        {"call": "scene.get", "save": {"scene": "/result"}, "expect": {"/result/frames": {"$len": 1}, "/result/groups": {"$len": 1}, "/result/wires": {"$len": 1}}},
        {"check": "nidsUnique", "scene": "$scene"}
