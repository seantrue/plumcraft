        {"call": "command.run", "params": {"command": "wire.connect", "params": {"from": {"node": "$a", "port": "text"}, "to": {"node": "$b", "port": "text"}}}},
        {"call": "command.run", "params": {"command": "wire.route", "params": {"to": {"node": "$b", "port": "text"}, "via": [[350, 300]]}}},
        {"gesture": {"kind": "drag", "phase": "begin", "at": [351, 301], "slop": 4}, "expect": {"/result/hit/kind": "bend", "/result/drag/kind": "bend"}},
        {"gesture": {"kind": "drag", "phase": "end", "at": [361, 311]}, "expect": {"/result/commands/0/command": "wire.route", "/result/commands/0/ok": true}},
        {"call": "graph.get", "expect": {"/result/wires/0/via": [[360, 310]]}},
        {"gesture": {"kind": "doubleTap", "at": [360, 310], "slop": 4}, "expect": {"/result/commands/0/command": "wire.route", "/result/commands/0/params/via": []}},
        {"call": "graph.get", "expect": {"/result/wires/0/via": {"$exists": false}}}
      ]
    },
    {
      "name": "the scene's colours are tokens alone or colours alone, and theme.get has every token",
