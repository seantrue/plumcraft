<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plummer's privacy manifest (the same in the Mac and the iPad and iPhone app). No tracking and
     no data collected: the app talks only to the engines it starts or is pointed at, and, in a debug
     build, to its own test driver; nothing is sent to the developer or anyone else. The required-reason
     APIs are the ones found in the built binaries and the sources (research note 24 section 19,
     Apple prep; the table is in claude-debug/native-n4-apple-prep.md). -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- the app's own settings (and, on the Mac, its launch arguments' domain) -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- stat and file dates: the store, caches and autosave in the app's container (C617.1), and
		     the graphs and files the person opens, to notice when one changed on disk (3B52.1) -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>
		<!-- free space: the store stops writing under a floor (E174.1); the Cache Report shows it (85F4.1) -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
				<string>85F4.1</string>
			</array>
		</dict>
		<!-- not declared, found unused in the binaries: system boot time (no mach_absolute_time or
		     systemUptime; timing is clock_gettime and CACurrentMediaTime) and active keyboards -->
	</array>
</dict>
</plist>
