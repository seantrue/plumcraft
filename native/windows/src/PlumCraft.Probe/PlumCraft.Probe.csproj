<Project Sdk="Microsoft.NET.Sdk">
  <!-- N5 spike: N0's flow from C# (open, list, build, run, status, blob) and the boundary's timings. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlumCraft.Core\PlumCraft.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the core, built by build-ffi.ps1 for this runtime -->
    <None Include="$(PlumFfiDir)\plumcraft_ffi.dll" Condition="'$(PlumFfiDir)' != ''" CopyToOutputDirectory="PreserveNewest" Link="plumcraft_ffi.dll" />
  </ItemGroup>
</Project>
