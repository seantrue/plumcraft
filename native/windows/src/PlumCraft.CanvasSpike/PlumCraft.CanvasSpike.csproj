<Project Sdk="Microsoft.NET.Sdk">
  <!-- N5 spike: a WinUI 3 window drawing the core's scene three ways (Win2D, Composition, XAML). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PlumCraft.CanvasSpike</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWinUI>true</UseWinUI>
    <Platforms>ARM64;x64</Platforms>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <!-- unpackaged, the Windows App SDK carried with the app: runs from its folder over SSH-launched tasks -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlumCraft.Core\PlumCraft.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PlumFfiDir)\plumcraft_ffi.dll" Condition="'$(PlumFfiDir)' != ''" CopyToOutputDirectory="PreserveNewest" Link="plumcraft_ffi.dll" />
  </ItemGroup>
</Project>
